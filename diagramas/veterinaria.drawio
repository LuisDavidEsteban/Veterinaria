        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Mascota {\n        &lt;&lt;abstract&gt;&gt;\n        +string Id\n        +string Nombre\n        +int Edad\n        +string Especie\n        +double PesoKg\n        +EmitirSonido()* string\n        +MostrarFicha() void\n    }\n\n    class Perro {\n        +string TamanioRaza\n        +EmitirSonido() string\n    }\n\n    class Gato {\n        +bool EsIndoor\n        +EmitirSonido() string\n    }\n\n    class Dueno {\n        +string Dpi\n        +string NombreCompleto\n        +string Telefono\n        +string Direccion\n    }\n\n    class Veterinario {\n        +string Colegiado\n        +string Nombre\n        +string Especialidad\n    }\n\n    class Consulta {\n        +string IdConsulta\n        +DateTime Fecha\n        +string Motivo\n        +string Diagnostico\n        +double Costo\n        +string Estado\n    }\n\n    class GestorClinica {\n        +List~Mascota~ lstMascotas\n        +List~Dueno~ lstDuenos\n        +List~Veterinario~ lstVeterinarios\n        +List~Consulta~ lstConsultas\n        +RegistrarDueno() void\n        +RegistrarMascota() void\n        +AgendarConsulta() void\n        +CompletarConsulta() void\n    }\n\n    Mascota &lt;|-- Perro\n    Mascota &lt;|-- Gato\n    Consulta --&gt; Mascota\n    Consulta --&gt; Dueno\n    Consulta --&gt; Veterinario\n    GestorClinica o-- Consulta\n    GestorClinica o-- Mascota\n    GestorClinica o-- Dueno&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Odlj9kVgi_irzFfKa03t-1">
